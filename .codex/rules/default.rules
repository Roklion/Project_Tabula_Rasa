# Allow routine project validation without an approval prompt.
prefix_rule(
    pattern = [["ruff", ".\\.venv\\Scripts\\ruff.exe"], "check"],
    decision = "allow",
    justification = "Project lint checks are preauthorized",
)

prefix_rule(
    pattern = [["python", ".\\.venv\\Scripts\\python.exe"], "-m", "pytest"],
    decision = "allow",
    justification = "Project tests are preauthorized",
)

# Allow local Git preparation and commits. Publishing remains approval-gated.
prefix_rule(
    pattern = ["git", "add"],
    decision = "allow",
    justification = "Staging project changes is preauthorized",
)

prefix_rule(
    pattern = ["git", "commit"],
    decision = "allow",
    justification = "Creating local commits is preauthorized; pushing is not",
)
