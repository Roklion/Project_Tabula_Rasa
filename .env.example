# Copy this file to .env.local in this repository root, then fill in the URL.
# .env.local is ignored by Git. Never put real credentials in this example.
# PostgreSQL tools load .env.local; process environment takes precedence.
# Use your Neon UAT branch's direct (unpooled) URL, retaining sslmode=require.
# Remove channel_binding=require if present; it is not a supported URL option.
# Example shape: postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
TABULA_RASA_DATABASE_URL=
TABULA_RASA_DATABASE_CONNECT_TIMEOUT=5
TABULA_RASA_DATABASE_POOL_SIZE=5
TABULA_RASA_DATABASE_MAX_OVERFLOW=5

# Automated tests require TABULA_RASA_TEST_DATABASE_URL in the process environment.
# Do not point tests at UAT/production; they create/drop disposable databases.
# This setting is intentionally omitted from .env.local.
