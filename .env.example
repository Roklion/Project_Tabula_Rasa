# Synthetic loopback-only local development. No production credentials here.
# The app/CLI reads process environment; it does not automatically load .env.
TABULA_DATABASE_URL=postgresql+psycopg://tabula_dev@127.0.0.1:55432/tabula_dev
TABULA_DATABASE_CONNECT_TIMEOUT=5
TABULA_DATABASE_POOL_SIZE=5
TABULA_DATABASE_MAX_OVERFLOW=5
# Test-only administrator endpoint; tests create/drop their own unique database.
TABULA_TEST_DATABASE_URL=postgresql+psycopg://tabula_dev@127.0.0.1:55432/tabula_dev
